#!/bin/sh

#
# configure for SklaffKOM
#
# Detects the build environment and writes config.h, config.mk and Makefile.
#

set -u

CC=${CC:-cc}
CPPFLAGS=${CPPFLAGS:-}
CFLAGS=${CFLAGS:-}
LDFLAGS=${LDFLAGS:-}

CONFIG_LIBS=""
STRL_PROVIDER=""
WITH_FROTZ=0
FROTZ_BUILD_TARGET=""
FROTZ_CLEAN_TARGET=""
FROTZ_MAKE=""
FROTZ_CURSES=""
HAVE_SKLAFF_LOCAL_H=0

usage()
{
    cat <<EOF_USAGE
Usage: ./configure [options]

Options:
  --with-frotz       Build the bundled SklaffKOM Frotz in vendor/frotz
  --without-frotz    Disable bundled Frotz support (default)
  -h, --help         Show this help
EOF_USAGE
}

for arg in "$@"; do
    case "$arg" in
        --with-frotz)
            WITH_FROTZ=1
            ;;
        --without-frotz)
            WITH_FROTZ=0
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "configure: unknown option: $arg" >&2
            echo "configure: try ./configure --help" >&2
            exit 1
            ;;
    esac
done

#
# Find a real executable in PATH.  Do not use command -v here: some core
# utilities, notably echo, may be reported as shell builtins instead of the
# external program SklaffKOM needs for exec().
#
find_program()
{
    prog=$1
    search_path=${PATH:-/usr/local/bin:/usr/bin:/bin}

    case "$prog" in
        */*)
            if [ -f "$prog" ] && [ -x "$prog" ]; then
                printf '%s\n' "$prog"
                return 0
            fi
            return 1
            ;;
    esac

    old_IFS=$IFS
    IFS=:

    for dir in $search_path; do
        [ -n "$dir" ] || dir=.

        if [ -f "$dir/$prog" ] && [ -x "$dir/$prog" ]; then
            IFS=$old_IFS
            printf '%s\n' "$dir/$prog"
            return 0
        fi
    done

    IFS=$old_IFS
    return 1
}

# Find the first available program from a list of equivalent names.
# This is useful for tools such as lrzsz, which may be installed as
# lrz/lsz or under the traditional rz/sz names.
find_first_program()
{
    for prog in "$@"; do
        if path=`find_program "$prog"`; then
            printf '%s\n' "$path"
            return 0
        fi
    done

    return 1
}

# Escape a pathname for use inside a C string literal.
c_escape_string()
{
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

tmpdir="${TMPDIR:-/tmp}/sklaff-configure.$$"

cleanup()
{
    rm -rf "$tmpdir"
}

trap cleanup 0
trap 'exit 1' HUP INT TERM

umask 077

if ! mkdir "$tmpdir"; then
    echo "configure: cannot create temporary directory" >&2
    exit 1
fi


echo
echo "Configuring SklaffKOM"
echo "====================="
echo

#
# Local site configuration
#

printf "%-36s" "Checking for sklaff_local.h..."

if [ -f sklaff_local.h ]; then
    HAVE_SKLAFF_LOCAL_H=1
    echo "yes"
else
    HAVE_SKLAFF_LOCAL_H=0
    echo "no"
fi

#
# Operating system
#

printf "%-36s" "Checking operating system..."

host_os=`uname -s 2>/dev/null || echo unknown`

case "$host_os" in
    Linux)
        sklaffsys=LINUX
        echo "Linux"
        ;;
    FreeBSD)
        sklaffsys=FREEBSD
        echo "FreeBSD"
        ;;
    Darwin)
        sklaffsys=DARWIN
        echo "Darwin (experimental)"
        echo "  WARNING: macOS is currently untested."
        ;;
    *)
        sklaffsys=UNKNOWN
        echo "$host_os (unsupported)"
        echo "  WARNING: this operating system has not been tested."
        ;;
esac


#
# C compiler
#

printf "%-36s" "Checking C compiler..."

if ! command -v "$CC" >/dev/null 2>&1; then
    echo "not found"
    echo
    echo "configure: no C compiler found: $CC" >&2
    exit 1
fi

cat > "$tmpdir/conftest.c" <<'EOF_TEST'
int
main(void)
{
    return 0;
}
EOF_TEST

if "$CC" $CPPFLAGS $CFLAGS "$tmpdir/conftest.c" \
    $LDFLAGS -o "$tmpdir/conftest" >/dev/null 2>&1; then
    echo "$CC"
else
    echo "failed"
    echo
    echo "configure: the C compiler cannot build executables." >&2
    exit 1
fi


#
# strlcpy / strlcat
#
# Linux uses SklaffKOM's bundled compatibility implementations.
# BSD-derived systems normally provide these functions in libc.
#

printf "%-36s" "Checking strlcpy/strlcat..."

if [ "$sklaffsys" = "LINUX" ]; then

    if [ ! -f lib/compat.c ]; then
        echo "failed"
        echo
        echo "configure: lib/compat.c is missing." >&2
        exit 1
    fi

    cat > "$tmpdir/conftest.c" <<'EOF_TEST'
#include <stddef.h>

size_t strlcpy(char *, const char *, size_t);
size_t strlcat(char *, const char *, size_t);

int
main(void)
{
    char buf[16];

    strlcpy(buf, "foo", sizeof(buf));
    strlcat(buf, "bar", sizeof(buf));

    return 0;
}
EOF_TEST

    if "$CC" $CPPFLAGS $CFLAGS -DLINUX -I. \
        "$tmpdir/conftest.c" lib/compat.c \
        $LDFLAGS -o "$tmpdir/conftest" >/dev/null 2>&1; then

        STRL_PROVIDER="bundled"
        echo "bundled compatibility functions"

    else
        echo "failed"
        echo
        echo "configure: bundled strlcpy/strlcat compatibility test failed." >&2
        exit 1
    fi

else

    cat > "$tmpdir/conftest.c" <<'EOF_TEST'
#include <string.h>

int
main(void)
{
    char buf[16];

    strlcpy(buf, "foo", sizeof(buf));
    strlcat(buf, "bar", sizeof(buf));

    return 0;
}
EOF_TEST

    if "$CC" $CPPFLAGS $CFLAGS "$tmpdir/conftest.c" \
        $LDFLAGS -o "$tmpdir/conftest" >/dev/null 2>&1; then

        STRL_PROVIDER="system"
        echo "yes"

    else
        echo "no"
        echo
        echo "configure: strlcpy() and strlcat() are required on $host_os." >&2
        echo "configure: no bundled compatibility implementation is used on this platform." >&2
        exit 1
    fi
fi

#
# Math library
#

printf "%-36s" "Checking math library..."

cat > "$tmpdir/conftest.c" <<'EOF_TEST'
#include <math.h>

int
main(void)
{
    double (*volatile fn)(double) = sqrt;
    volatile double value = 2.0;

    return fn(value) < 0.0;
}
EOF_TEST

if "$CC" $CPPFLAGS $CFLAGS "$tmpdir/conftest.c" \
    $LDFLAGS -o "$tmpdir/conftest" >/dev/null 2>&1; then

    echo "not needed"

elif "$CC" $CPPFLAGS $CFLAGS "$tmpdir/conftest.c" \
    $LDFLAGS -lm -o "$tmpdir/conftest" >/dev/null 2>&1; then

    echo "-lm"
    CONFIG_LIBS="${CONFIG_LIBS}${CONFIG_LIBS:+ }-lm"

else
    echo "failed"
    echo
    echo "configure: math library support is required." >&2
    exit 1
fi


#
# Bundled SklaffKOM Frotz
#
# Frotz is deliberately opt-in.  SklaffKOM does not use or fall back to
# a stock/system Frotz; --with-frotz always means vendor/frotz.
#

if [ "$WITH_FROTZ" -eq 1 ]; then
    printf "%-36s" "Checking bundled Frotz source..."
    if [ -f vendor/frotz/Makefile ]; then
        echo "vendor/frotz"
    else
        echo "not found"
        echo
        echo "configure: --with-frotz was requested, but vendor/frotz/Makefile is missing." >&2
        exit 1
    fi

    printf "%-36s" "Checking for GNU make..."
    if command -v gmake >/dev/null 2>&1; then
        FROTZ_MAKE=gmake
        echo "$FROTZ_MAKE"
    elif command -v make >/dev/null 2>&1 &&
         make --version 2>/dev/null | grep 'GNU Make' >/dev/null 2>&1; then
        FROTZ_MAKE=make
        echo "$FROTZ_MAKE"
    else
        echo "not found"
        echo
        echo "configure: bundled Frotz requires GNU make." >&2
        echo "configure: install GNU make (gmake on BSD systems) and run ./configure again." >&2
        exit 1
    fi

    printf "%-36s" "Checking ncursesw for Frotz..."

    FROTZ_CURSES_CFLAGS=""
    FROTZ_CURSES_LIBS=""

    if command -v pkgconf >/dev/null 2>&1 && pkgconf --exists ncursesw 2>/dev/null; then
        FROTZ_CURSES_CFLAGS=`pkgconf --cflags ncursesw 2>/dev/null || true`
        FROTZ_CURSES_LIBS=`pkgconf --libs ncursesw 2>/dev/null || true`
    elif command -v pkg-config >/dev/null 2>&1 && pkg-config --exists ncursesw 2>/dev/null; then
        FROTZ_CURSES_CFLAGS=`pkg-config --cflags ncursesw 2>/dev/null || true`
        FROTZ_CURSES_LIBS=`pkg-config --libs ncursesw 2>/dev/null || true`
    fi

    cat > "$tmpdir/conftest.c" <<'EOF_TEST'
#include <curses.h>

int
main(void)
{
    WINDOW *w = initscr();
    if (w != 0)
        endwin();
    return 0;
}
EOF_TEST

    frotz_curses_ok=no

    if [ -n "$FROTZ_CURSES_LIBS" ] &&
       "$CC" $CPPFLAGS $CFLAGS $FROTZ_CURSES_CFLAGS \
           "$tmpdir/conftest.c" $LDFLAGS $FROTZ_CURSES_LIBS \
           -o "$tmpdir/conftest" >/dev/null 2>&1; then
        frotz_curses_ok=yes
    fi

    if [ "$frotz_curses_ok" = no ]; then
        case "$sklaffsys" in
            FREEBSD)
                frotz_fallback_cflags="-I/usr/local/include"
                frotz_fallback_ldflags="-L/usr/local/lib"
                ;;
            *)
                frotz_fallback_cflags=""
                frotz_fallback_ldflags=""
                ;;
        esac

        for frotz_libs in "-lncursesw -ltinfo" "-lncursesw"; do
            if "$CC" $CPPFLAGS $CFLAGS $frotz_fallback_cflags \
                "$tmpdir/conftest.c" $LDFLAGS $frotz_fallback_ldflags \
                $frotz_libs -o "$tmpdir/conftest" >/dev/null 2>&1; then
                FROTZ_CURSES_CFLAGS=$frotz_fallback_cflags
                FROTZ_CURSES_LIBS=$frotz_libs
                frotz_curses_ok=yes
                break
            fi
        done
    fi

    if [ "$frotz_curses_ok" = yes ]; then
        FROTZ_CURSES=ncursesw
        echo "yes"
    else
        echo "not found"
        echo
        echo "configure: --with-frotz was requested, but ncursesw development files were not found." >&2
        echo "configure: install the ncurses wide-character development package and try again." >&2
        exit 1
    fi

    FROTZ_BUILD_TARGET=frotz
    FROTZ_CLEAN_TARGET=clean-frotz
else
    printf "%-36s" "Bundled Frotz support..."
    echo "disabled"
fi


#
# Core runtime tools
#
# These programs are required by the base SklaffKOM runtime.  Missing core
# tools are fatal; optional transports and utilities are detected separately.
#

printf "%-36s" "Checking for grep..."
if GREP_BIN=`find_program grep`; then
    echo "$GREP_BIN"
else
    echo "not found"
    echo
    echo "configure: grep is required." >&2
    exit 1
fi

printf "%-36s" "Checking for ls..."
if LS_BIN=`find_program ls`; then
    echo "$LS_BIN"
else
    echo "not found"
    echo
    echo "configure: ls is required." >&2
    exit 1
fi

printf "%-36s" "Checking for echo..."
if ECHO_BIN=`find_program echo`; then
    echo "$ECHO_BIN"
else
    echo "not found"
    echo
    echo "configure: echo is required." >&2
    exit 1
fi

printf "%-36s" "Checking for passwd..."
if PASSWD_BIN=`find_program passwd`; then
    echo "$PASSWD_BIN"
else
    echo "not found"
    echo
    echo "configure: passwd is required." >&2
    exit 1
fi


#
# ZMODEM file transfer tools
#
# lrzsz is commonly installed either as lrz/lsz or under the traditional
# rz/sz names.  Prefer lrz/lsz when both forms are available.
#

printf "%-36s" "Checking for ZMODEM receiver..."
if LRZ_BIN=`find_first_program lrz rz`; then
    echo "$LRZ_BIN"
else
    echo "not found"
    echo
    echo "configure: a ZMODEM receiver is required (tried lrz and rz)." >&2
    echo "configure: install lrzsz and run ./configure again." >&2
    exit 1
fi

printf "%-36s" "Checking for ZMODEM sender..."
if LSZ_BIN=`find_first_program lsz sz`; then
    echo "$LSZ_BIN"
else
    echo "not found"
    echo
    echo "configure: a ZMODEM sender is required (tried lsz and sz)." >&2
    echo "configure: install lrzsz and run ./configure again." >&2
    exit 1
fi

# Quote detected paths for config.h.
GREP_BIN_C=`c_escape_string "$GREP_BIN"`
LS_BIN_C=`c_escape_string "$LS_BIN"`
ECHO_BIN_C=`c_escape_string "$ECHO_BIN"`
PASSWD_BIN_C=`c_escape_string "$PASSWD_BIN"`
LRZ_BIN_C=`c_escape_string "$LRZ_BIN"`
LSZ_BIN_C=`c_escape_string "$LSZ_BIN"`


#
# config.h
#

cat > config.h.tmp <<EOF_CONFIG
/*
 * config.h
 *
 * Generated by ./configure.
 * Do not edit manually.
 */

#ifndef SKLAFF_CONFIG_H
#define SKLAFF_CONFIG_H

#define SKLAFF_CONFIGURED 1

/* Optional local site configuration */
#define HAVE_SKLAFF_LOCAL_H $HAVE_SKLAFF_LOCAL_H

/* Bundled SklaffKOM Frotz */
#define HAVE_FROTZ $WITH_FROTZ
#define FROTZ_BIN SKLAFFDIR "/libexec/frotz"

/* Core runtime tools */
#define GREP_BIN "$GREP_BIN_C"
#define LS_BIN "$LS_BIN_C"
#define ECHO_BIN "$ECHO_BIN_C"
#define PASSWD_BIN "$PASSWD_BIN_C"

/* ZMODEM file transfer tools */
#define LRZ_BIN "$LRZ_BIN_C"
#define LSZ_BIN "$LSZ_BIN_C"

#endif /* SKLAFF_CONFIG_H */
EOF_CONFIG

mv config.h.tmp config.h


#
# config.mk
#

cat > config.mk.tmp <<EOF_CONFIG
#
# config.mk
#
# Generated by ./configure.
# Do not edit manually.
#

CONFIG_CC = $CC
CONFIG_SKLAFFSYS = $sklaffsys
CONFIG_LIBS = $CONFIG_LIBS
CONFIG_WITH_FROTZ = $WITH_FROTZ
EOF_CONFIG

mv config.mk.tmp config.mk


#
# Makefile
#

#
# Generate Makefile from Makefile.in
#

printf "%-36s" "Generating Makefile..."

if [ ! -f Makefile.in ]; then
    echo "failed"
    echo
    echo "configure: Makefile.in is missing." >&2
    exit 1
fi

# Escape characters that are special in the replacement part of sed's
# substitute command.
sed_escape_replacement()
{
    printf '%s' "$1" | sed 's/[\\&|]/\\&/g'
}

sed_cc=`sed_escape_replacement "$CC"`
sed_sys=`sed_escape_replacement "$sklaffsys"`
sed_libs=`sed_escape_replacement "$CONFIG_LIBS"`
sed_with_frotz=`sed_escape_replacement "$WITH_FROTZ"`
sed_frotz_build_target=`sed_escape_replacement "$FROTZ_BUILD_TARGET"`
sed_frotz_clean_target=`sed_escape_replacement "$FROTZ_CLEAN_TARGET"`

if sed \
    -e "s|@CC@|$sed_cc|g" \
    -e "s|@SKLAFFSYS@|$sed_sys|g" \
    -e "s|@LIBS@|$sed_libs|g" \
    -e "s|@WITH_FROTZ@|$sed_with_frotz|g" \
    -e "s|@FROTZ_BUILD_TARGET@|$sed_frotz_build_target|g" \
    -e "s|@FROTZ_CLEAN_TARGET@|$sed_frotz_clean_target|g" \
    Makefile.in > Makefile.tmp; then

    mv Makefile.tmp Makefile
    echo "done"
else
    rm -f Makefile.tmp
    echo "failed"
    echo
    echo "configure: could not generate Makefile." >&2
    exit 1
fi


#
# Summary
#

echo
echo "Configuration successful."
echo
echo "  Operating system: $host_os"
echo "  Target system:    $sklaffsys"
echo "  C compiler:       $CC"
echo "  strlcpy/strlcat:  $STRL_PROVIDER"
if [ "$WITH_FROTZ" -eq 1 ]; then
    echo "  Bundled Frotz:    enabled ($FROTZ_CURSES)"
    echo "  Frotz path:       /usr/local/sklaff/libexec/frotz"
else
    echo "  Bundled Frotz:    disabled"
fi

if [ -n "$CONFIG_LIBS" ]; then
    echo "  Extra libraries:  $CONFIG_LIBS"
else
    echo "  Extra libraries:  none"
fi

echo
echo "Generated:"
echo "  config.h"
echo "  config.mk"
echo "  Makefile"
echo

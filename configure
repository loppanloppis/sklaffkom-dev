#!/bin/sh

#
# configure for SklaffKOM
#
# Detects the build environment and writes config.h, config.mk and Makefile.
#

set -u

CC=${CC:-cc}
CPPFLAGS=${CPPFLAGS:-}
CFLAGS=${CFLAGS:-}
LDFLAGS=${LDFLAGS:-}

CONFIG_LIBS=""
STRL_PROVIDER=""

tmpdir="${TMPDIR:-/tmp}/sklaff-configure.$$"

cleanup()
{
    rm -rf "$tmpdir"
}

trap cleanup 0
trap 'exit 1' HUP INT TERM

umask 077

if ! mkdir "$tmpdir"; then
    echo "configure: cannot create temporary directory" >&2
    exit 1
fi


echo
echo "Configuring SklaffKOM"
echo "====================="
echo


#
# Operating system
#

printf "%-36s" "Checking operating system..."

host_os=`uname -s 2>/dev/null || echo unknown`

case "$host_os" in
    Linux)
        sklaffsys=LINUX
        echo "Linux"
        ;;
    FreeBSD)
        sklaffsys=FREEBSD
        echo "FreeBSD"
        ;;
    Darwin)
        sklaffsys=DARWIN
        echo "Darwin (experimental)"
        echo "  WARNING: macOS is currently untested."
        ;;
    *)
        sklaffsys=UNKNOWN
        echo "$host_os (unsupported)"
        echo "  WARNING: this operating system has not been tested."
        ;;
esac


#
# C compiler
#

printf "%-36s" "Checking C compiler..."

if ! command -v "$CC" >/dev/null 2>&1; then
    echo "not found"
    echo
    echo "configure: no C compiler found: $CC" >&2
    exit 1
fi

cat > "$tmpdir/conftest.c" <<'EOF_TEST'
int
main(void)
{
    return 0;
}
EOF_TEST

if "$CC" $CPPFLAGS $CFLAGS "$tmpdir/conftest.c" \
    $LDFLAGS -o "$tmpdir/conftest" >/dev/null 2>&1; then
    echo "$CC"
else
    echo "failed"
    echo
    echo "configure: the C compiler cannot build executables." >&2
    exit 1
fi


#
# strlcpy / strlcat
#
# Linux uses SklaffKOM's bundled compatibility implementations.
# BSD-derived systems normally provide these functions in libc.
#

printf "%-36s" "Checking strlcpy/strlcat..."

if [ "$sklaffsys" = "LINUX" ]; then

    if [ ! -f lib/compat.c ]; then
        echo "failed"
        echo
        echo "configure: lib/compat.c is missing." >&2
        exit 1
    fi

    cat > "$tmpdir/conftest.c" <<'EOF_TEST'
#include <stddef.h>

size_t strlcpy(char *, const char *, size_t);
size_t strlcat(char *, const char *, size_t);

int
main(void)
{
    char buf[16];

    strlcpy(buf, "foo", sizeof(buf));
    strlcat(buf, "bar", sizeof(buf));

    return 0;
}
EOF_TEST

    if "$CC" $CPPFLAGS $CFLAGS -DLINUX -I. \
        "$tmpdir/conftest.c" lib/compat.c \
        $LDFLAGS -o "$tmpdir/conftest" >/dev/null 2>&1; then

        STRL_PROVIDER="bundled"
        echo "bundled compatibility functions"

    else
        echo "failed"
        echo
        echo "configure: bundled strlcpy/strlcat compatibility test failed." >&2
        exit 1
    fi

else

    cat > "$tmpdir/conftest.c" <<'EOF_TEST'
#include <string.h>

int
main(void)
{
    char buf[16];

    strlcpy(buf, "foo", sizeof(buf));
    strlcat(buf, "bar", sizeof(buf));

    return 0;
}
EOF_TEST

    if "$CC" $CPPFLAGS $CFLAGS "$tmpdir/conftest.c" \
        $LDFLAGS -o "$tmpdir/conftest" >/dev/null 2>&1; then

        STRL_PROVIDER="system"
        echo "yes"

    else
        echo "no"
        echo
        echo "configure: strlcpy() and strlcat() are required on $host_os." >&2
        echo "configure: no bundled compatibility implementation is used on this platform." >&2
        exit 1
    fi
fi

#
# Math library
#

printf "%-36s" "Checking math library..."

cat > "$tmpdir/conftest.c" <<'EOF_TEST'
#include <math.h>

int
main(void)
{
    double (*volatile fn)(double) = sqrt;
    volatile double value = 2.0;

    return fn(value) < 0.0;
}
EOF_TEST

if "$CC" $CPPFLAGS $CFLAGS "$tmpdir/conftest.c" \
    $LDFLAGS -o "$tmpdir/conftest" >/dev/null 2>&1; then

    echo "not needed"

elif "$CC" $CPPFLAGS $CFLAGS "$tmpdir/conftest.c" \
    $LDFLAGS -lm -o "$tmpdir/conftest" >/dev/null 2>&1; then

    echo "-lm"
    CONFIG_LIBS="${CONFIG_LIBS}${CONFIG_LIBS:+ }-lm"

else
    echo "failed"
    echo
    echo "configure: math library support is required." >&2
    exit 1
fi

#
# config.h
#

cat > config.h.tmp <<EOF_CONFIG
/*
 * config.h
 *
 * Generated by ./configure.
 * Do not edit manually.
 */

#ifndef SKLAFF_CONFIG_H
#define SKLAFF_CONFIG_H

#define SKLAFF_CONFIGURED 1

#endif /* SKLAFF_CONFIG_H */
EOF_CONFIG

mv config.h.tmp config.h


#
# config.mk
#

cat > config.mk.tmp <<EOF_CONFIG
#
# config.mk
#
# Generated by ./configure.
# Do not edit manually.
#

CONFIG_CC = $CC
CONFIG_SKLAFFSYS = $sklaffsys
CONFIG_LIBS = $CONFIG_LIBS
EOF_CONFIG

mv config.mk.tmp config.mk


#
# Makefile
#

#
# Generate Makefile from Makefile.in
#

printf "%-36s" "Generating Makefile..."

if [ ! -f Makefile.in ]; then
    echo "failed"
    echo
    echo "configure: Makefile.in is missing." >&2
    exit 1
fi

# Escape characters that are special in the replacement part of sed's
# substitute command.
sed_escape_replacement()
{
    printf '%s' "$1" | sed 's/[\\&|]/\\&/g'
}

sed_cc=`sed_escape_replacement "$CC"`
sed_sys=`sed_escape_replacement "$sklaffsys"`
sed_libs=`sed_escape_replacement "$CONFIG_LIBS"`

if sed \
    -e "s|@CC@|$sed_cc|g" \
    -e "s|@SKLAFFSYS@|$sed_sys|g" \
    -e "s|@LIBS@|$sed_libs|g" \
    Makefile.in > Makefile.tmp; then

    mv Makefile.tmp Makefile
    echo "done"
else
    rm -f Makefile.tmp
    echo "failed"
    echo
    echo "configure: could not generate Makefile." >&2
    exit 1
fi


#
# Summary
#

echo
echo "Configuration successful."
echo
echo "  Operating system: $host_os"
echo "  Target system:    $sklaffsys"
echo "  C compiler:       $CC"
echo "  strlcpy/strlcat:  $STRL_PROVIDER"

if [ -n "$CONFIG_LIBS" ]; then
    echo "  Extra libraries:  $CONFIG_LIBS"
else
    echo "  Extra libraries:  none"
fi

echo
echo "Generated:"
echo "  config.h"
echo "  config.mk"
echo "  Makefile"
echo
